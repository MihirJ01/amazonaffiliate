VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
VITE_SITE_URL=https://your-vercel-domain.vercel.app

# Server-only: do not add VITE_ to these names and never commit real values.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SEARCHAPI_KEY=your-searchapi-secret-key
# Optional. Leave blank to use SearchAPI's default Amazon marketplace.
SEARCHAPI_AMAZON_DOMAIN=amazon.in

# Used only by the daily Vercel price refresh. Never expose these values in VITE_ variables.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
CRON_SECRET=create-a-long-random-secret

# Optional: Vercel forwards Playwright imports to this secured service on your laptop.
PLAYWRIGHT_SERVICE_URL=https://your-public-tunnel.example.com
PLAYWRIGHT_SERVICE_SECRET=create-a-different-long-random-secret
